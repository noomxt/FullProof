          "claim_id": {
            "type": "string",
            "minLength": 1,
            "title": "Claim Id"
          },
          "claim_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Claim Version"
          },
          "step_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Step Id"
          },
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "title": "Claim Text"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "claim_version",
          "step_id",
          "claim_text"
        ],
        "title": "ClaimCreateSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProofAttestationSchema": {
        "properties": {
