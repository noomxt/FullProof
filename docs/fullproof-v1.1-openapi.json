            "type": "string",
            "title": "Case Id"
          },
          "step_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Step Id"
          },
          "proof_id": {
            "type": "string",
            "minLength": 1,
            "title": "Proof Id"
          },
          "proof_version": {
